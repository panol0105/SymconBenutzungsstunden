{
    "elements": [
        {
            "type": "Label",
            "caption": "Zeigt Wirkleistung, Scheinleistung, cos φ, Auslastung und Wirkarbeit je Trafo. Leistungsvariablen (W, VA, var) im Archiv mit Aggregationstyp „Standard“, Energiezähler mit „Zähler“ loggen. Faktoren beziehen sich auf den Rohwert der Variable – nicht auf die in Symcon eingestellte Darstellung (W/VA/var/Wh → 0,001)."
        },
        {
            "type": "List",
            "name": "Trafos",
            "caption": "Trafos",
            "rowCount": 6,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {
                    "caption": "Name",
                    "name": "Name",
                    "width": "140px",
                    "add": "Trafo",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Wirkleistung",
                    "name": "PowerVariable",
                    "width": "auto",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Faktor Leistung → kW",
                    "name": "PowerFactor",
                    "width": "150px",
                    "add": 0.001,
                    "edit": {
                        "type": "NumberSpinner",
                        "digits": 4
                    }
                },
                {
                    "caption": "Wirkarbeit (Zähler, optional)",
                    "name": "EnergyVariable",
                    "width": "220px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Faktor Energie → kWh",
                    "name": "EnergyFactor",
                    "width": "150px",
                    "add": 0.001,
                    "edit": {
                        "type": "NumberSpinner",
                        "digits": 4
                    }
                },
                {
                    "caption": "Scheinleistung (VA, optional)",
                    "name": "ApparentVariable",
                    "width": "220px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Faktor Schein → kVA",
                    "name": "ApparentFactor",
                    "width": "140px",
                    "add": 0.001,
                    "edit": {
                        "type": "NumberSpinner",
                        "digits": 4
                    }
                },
                {
                    "caption": "Blindleistung (var, mit Vorzeichen, optional)",
                    "name": "ReactiveVariable",
                    "width": "220px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Faktor Blind → kvar",
                    "name": "ReactiveFactor",
                    "width": "140px",
                    "add": 0.001,
                    "edit": {
                        "type": "NumberSpinner",
                        "digits": 4
                    }
                },
                {
                    "caption": "Blindarbeit induktiv (varh, optional)",
                    "name": "QEnergyVariable",
                    "width": "230px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Blindarbeit kapazitiv (varh, optional)",
                    "name": "QEnergyCapVariable",
                    "width": "230px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Faktor Blindarbeit → kvarh",
                    "name": "QEnergyFactor",
                    "width": "170px",
                    "add": 0.001,
                    "edit": {
                        "type": "NumberSpinner",
                        "digits": 4
                    }
                },
                {
                    "caption": "Nennleistung [kVA]",
                    "name": "Nominal",
                    "width": "130px",
                    "add": 0,
                    "edit": {
                        "type": "NumberSpinner",
                        "digits": 0,
                        "suffix": " kVA"
                    }
                },
                {
                    "caption": "Farbe",
                    "name": "Color",
                    "width": "80px",
                    "add": -1,
                    "edit": {
                        "type": "SelectColor",
                        "allowTransparent": true
                    }
                }
            ]
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Select",
                    "name": "DefaultRange",
                    "caption": "Startansicht",
                    "options": [
                        {
                            "caption": "Heute",
                            "value": 0
                        },
                        {
                            "caption": "Woche",
                            "value": 1
                        },
                        {
                            "caption": "Monat",
                            "value": 2
                        },
                        {
                            "caption": "Jahr",
                            "value": 3
                        }
                    ]
                },
                {
                    "type": "CheckBox",
                    "name": "ShowSum",
                    "caption": "Summenlinie anzeigen"
                },
                {
                    "type": "CheckBox",
                    "name": "Live",
                    "caption": "Live-Aktualisierung bei Wertänderung"
                },
                {
                    "type": "CheckBox",
                    "name": "InvertReactive",
                    "caption": "Vorzeichen Blindleistung umkehren (wenn induktiv negativ geliefert wird)"
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Auslastung = Scheinleistung ÷ Nennleistung (kVA). Ohne Scheinleistung vereinfacht Wirkleistung ÷ Nennleistung (cos φ ≈ 1). cos φ = Wirkleistung ÷ Scheinleistung."
        },
        {
            "type": "Label",
            "caption": "Blindleistung mit Vorzeichen: + = induktiv, − = kapazitiv. Damit wird der Gesamt-cos φ vektoriell berechnet (ΣP ÷ √(ΣP² + ΣQ²)). Blindarbeitszähler (Archiv: „Zähler“) liefern den Abrechnungs-cos φ je Zeitraum."
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Kachel aktualisieren",
            "onClick": "TRM_Refresh($id);"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Aktiv"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "Keine Trafos konfiguriert"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Kein Archiv gefunden"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Mindestens ein Trafo ist fehlerhaft konfiguriert (siehe Kachel/Meldungen)"
        }
    ]
}
